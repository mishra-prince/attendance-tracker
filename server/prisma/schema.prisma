generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  HOD
  TEACHER
  STUDENT
}

enum SubjectType {
  theory
  lab
  tutorial
}

enum DayOfWeek {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
}

enum SessionType {
  lecture
  lab
  tutorial
}

enum ClassSessionStatus {
  scheduled
  open
  submitted
  locked
  cancelled
}

enum AttendanceStatus {
  present
  absent
  late
  excused
  on_duty
  medical
}

enum AttendanceMethod {
  manual
  QR
  BLE_AUTO
  RFID
}

enum EnrollmentStatus {
  active
  dropped
  completed
}

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum NotificationType {
  low_attendance
  leave_status
  correction_status
  announcement
}

enum NotificationChannel {
  in_app
  email
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  LOCK
  BLE_FINALIZE
  BIOMETRIC_ENROLLMENT
  BIOMETRIC_REVOCATION
}

// --- Integrity architecture (Threshold FINAL INTEGRITY ARCHITECTURE PATCH) ---

// Root-of-trust lifecycle for a student's biometric identity.
enum EnrollmentTrustState {
  UNENROLLED
  PENDING_SUPERVISED_ENROLLMENT
  ACTIVE
  REVOKED
  REQUIRES_REENROLLMENT
}

// Status of a single BiometricEnrollment record.
enum BiometricEnrollmentStatus {
  active
  revoked
  replaced
}

// How institutional identity was anchored at enrollment time. Configurable.
enum EnrollmentMethod {
  SUPERVISED_STAFF
  INSTITUTIONAL_ID_CARD
  REGISTRATION_RECORD
  TRUSTED_IDENTITY_SYSTEM
  BIOMETRIC_ENROLLMENT_STATION
}

// Device attestation outcome. `unavailable`/`error` are NOT failures of honesty.
enum AttestationResult {
  passed
  failed
  unavailable
  error
}

enum AttestationType {
  PLAY_INTEGRITY
  APP_ATTEST
  NONE
}

// Policy applied when attestation cannot pass. Institution-configured, never client-chosen.
enum AttestationPolicy {
  ALLOW_WITH_LOWER_ASSURANCE
  REQUIRE_ALTERNATIVE_VERIFICATION
  TEACHER_REVIEW
}

// Attendance assurance mode. Downgrade is institution-policy-only.
enum AttendanceAssuranceMode {
  MODE_A
  MODE_B
  MODE_C
}

model User {
  user_id       String    @id @default(uuid())
  name          String
  email         String    @unique
  password_hash String
  role          Role
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  student   Student?        @relation("UserStudent")
  teacher   Teacher?        @relation("UserTeacher")
  corrections AttendanceCorrection[] @relation("RequestedBy")
  correctionsReviewed AttendanceCorrection[] @relation("ReviewedBy")
  leavesApproved Leave[]    @relation("ApprovedBy")
  attendanceMarked Attendance[] @relation("MarkedBy")
  auditLogs AuditLog[]      @relation("ChangedBy")
  settings  Settings[]      @relation("UpdatedBy")
  notifications Notification[] @relation("UserNotifications")
  biometricEnrollmentsVerified BiometricEnrollment[] @relation("BiometricEnrolledBy")
  refreshSessions RefreshSession[]
  rfidReaders RfidReader[]
  rfidCards RfidCard[]
  faceChallenges FaceChallenge[]
}

model RefreshSession {
  session_id String @id @default(uuid())
  user_id String
  token_hash String @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime @default(now())
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  @@index([user_id, expires_at])
}

model Department {
  department_id String   @id @default(uuid())
  name          String
  code          String   @unique
  hod_id        String?  @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  hod      Teacher?  @relation("DeptHOD", fields: [hod_id], references: [teacher_id])
  courses  Course[]
  teachers Teacher[] @relation("DeptTeachers")
}

model AcademicYear {
  academic_year_id String  @id @default(uuid())
  name             String  @unique
  start_date       DateTime
  end_date         DateTime
  is_current       Boolean @default(false)

  semesters Semester[]
}

model Semester {
  semester_id      String @id @default(uuid())
  academic_year_id String
  semester_number  Int
  start_date       DateTime
  end_date         DateTime
  is_active        Boolean @default(true)

  academicYear AcademicYear @relation(fields: [academic_year_id], references: [academic_year_id])
  sections     Section[]
  subjects     Subject[]
  enrollments  Enrollment[]

  @@unique([academic_year_id, semester_number])
}

model Course {
  course_id      String @id @default(uuid())
  course_name    String
  course_code    String @unique
  department_id  String
  duration_years Int    @default(4)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  department Department @relation(fields: [department_id], references: [department_id])
  sections   Section[]
  subjects   Subject[]
  students   Student[]
}

model Section {
  section_id   String @id @default(uuid())
  section_name String
  course_id    String
  semester_id  String
  join_code    String? @unique
  join_code_expires_at DateTime?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  course      Course   @relation(fields: [course_id], references: [course_id])
  semester    Semester @relation(fields: [semester_id], references: [semester_id])
  students    Student[]
  subjectTeachers SubjectTeacher[]
  enrollments Enrollment[]
  timetables  Timetable[]
  classSessions ClassSession[]
}

model Subject {
  subject_id   String @id @default(uuid())
  subject_code String @unique
  subject_name String
  course_id    String
  semester_id  String
  credits      Int    @default(3)
  type         SubjectType @default(theory)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  course    Course   @relation(fields: [course_id], references: [course_id])
  semester  Semester @relation(fields: [semester_id], references: [semester_id])
  subjectTeachers SubjectTeacher[]
  enrollments Enrollment[]
  timetables  Timetable[]
  classSessions ClassSession[]
}

model SubjectTeacher {
  id         String @id @default(uuid())
  subject_id String
  teacher_id String
  section_id String
  created_at DateTime @default(now())

  subject Subject @relation(fields: [subject_id], references: [subject_id])
  teacher Teacher @relation(fields: [teacher_id], references: [teacher_id])
  section Section @relation(fields: [section_id], references: [section_id])
  timetables Timetable[]

  @@unique([subject_id, section_id])
}

model Student {
  student_id   String @id @default(uuid())
  user_id      String @unique
  name         String
  roll_no      String @unique
  email        String @unique
  phone        String?
  course_id    String
  section_id   String
  parent_email String?
  parent_phone String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  // Enrollment trust state — the root-of-trust gate for Mode B/C biometric verification.
  enrollment_trust_state EnrollmentTrustState @default(UNENROLLED)

  user        User     @relation("UserStudent", fields: [user_id], references: [user_id])
  course      Course   @relation(fields: [course_id], references: [course_id])
  blePings    BlePing[]
  anchorSightings AnchorSighting[]
  section     Section  @relation(fields: [section_id], references: [section_id])
  enrollments Enrollment[]
  attendance  Attendance[]
  leaves      Leave[]
  notifications Notification[]
  biometricEnrollment BiometricEnrollment?
  deviceIntegrityEvents DeviceIntegrityEvent[]
  rfidCards RfidCard[]
  rfidEvents RfidEvent[]
  rfidVisits RfidVisit[]
  faceChallenges FaceChallenge[]
  faceRequirements FaceRequirement[]
}

model Teacher {
  teacher_id    String @id @default(uuid())
  user_id       String @unique
  name          String
  employee_id   String @unique
  department_id String
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  user        User     @relation("UserTeacher", fields: [user_id], references: [user_id])
  department  Department @relation("DeptTeachers", fields: [department_id], references: [department_id])
  hodOf       Department? @relation("DeptHOD")
  subjectTeachers SubjectTeacher[]
  timetables  Timetable[]
  classSessions ClassSession[]
}

model Enrollment {
  enrollment_id String @id @default(uuid())
  student_id    String
  subject_id    String
  semester_id   String
  section_id    String
  status        EnrollmentStatus @default(active)
  enrolled_at   DateTime @default(now())
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  student Student  @relation(fields: [student_id], references: [student_id])
  subject Subject  @relation(fields: [subject_id], references: [subject_id])
  semester Semester @relation(fields: [semester_id], references: [semester_id])
  section Section  @relation(fields: [section_id], references: [section_id])

  @@index([student_id, semester_id, status])
  @@unique([student_id, subject_id, semester_id, section_id])
}

model Timetable {
  timetable_id String @id @default(uuid())
  subject_id   String
  section_id   String
  teacher_id   String
  day_of_week  DayOfWeek
  start_time   String
  end_time     String
  room_no      String
  session_type SessionType @default(lecture)
  is_active    Boolean @default(true)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  subject  Subject @relation(fields: [subject_id], references: [subject_id])
  section  Section @relation(fields: [section_id], references: [section_id])
  teacher  Teacher @relation(fields: [teacher_id], references: [teacher_id])
  subjectTeacher SubjectTeacher? @relation(fields: [subject_id, section_id], references: [subject_id, section_id])
  classSessions ClassSession[]

  @@index([teacher_id, day_of_week])
  @@index([section_id, day_of_week])
  @@index([room_no, day_of_week])
}

model ClassSession {
  session_id   String @id @default(uuid())
  timetable_id String?
  room_no      String?
  subject_id   String
  section_id   String
  teacher_id   String
  date         DateTime
  start_time   String
  end_time     String
  session_type SessionType @default(lecture)
  status       ClassSessionStatus @default(scheduled)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  timetable  Timetable? @relation(fields: [timetable_id], references: [timetable_id])
  subject    Subject    @relation(fields: [subject_id], references: [subject_id])
  section    Section    @relation(fields: [section_id], references: [section_id])
  teacher    Teacher    @relation(fields: [teacher_id], references: [teacher_id])
  attendance Attendance[]
  qrSessions AttendanceQRSession[]
  rfidEvents RfidEvent[]
  rfidVisits RfidVisit[]
  faceChallenges FaceChallenge[]
  faceRequirements FaceRequirement[]

  @@index([section_id, date])
  @@index([teacher_id, date])
}

model Attendance {
  attendance_id String @id @default(uuid())
  session_id    String
  student_id    String
  status        AttendanceStatus
  marked_by     String
  method        AttendanceMethod @default(manual)
  marked_at     DateTime @default(now())
  device_id     String?
  remarks       String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  session ClassSession @relation(fields: [session_id], references: [session_id])
  student Student      @relation(fields: [student_id], references: [student_id])
  markedByUser User    @relation("MarkedBy", fields: [marked_by], references: [user_id])
  corrections AttendanceCorrection[]

  @@unique([session_id, student_id])
  @@index([student_id, session_id])
}

model AttendanceCorrection {
  correction_id    String @id @default(uuid())
  attendance_id    String
  requested_by     String
  old_status       AttendanceStatus
  requested_status AttendanceStatus
  reason           String
  document_url     String?
  status           ApprovalStatus @default(pending)
  reviewed_by      String?
  reviewed_at      DateTime?
  rejection_reason String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  attendance Attendance @relation(fields: [attendance_id], references: [attendance_id])
  requestedByUser User  @relation("RequestedBy", fields: [requested_by], references: [user_id])
  reviewedByUser  User? @relation("ReviewedBy", fields: [reviewed_by], references: [user_id])
}

model AttendanceQRSession {
  qr_id      String @id @default(uuid())
  session_id String
  token_hash String
  created_at DateTime @default(now())
  expires_at DateTime
  revoked_at DateTime?

  session ClassSession @relation(fields: [session_id], references: [session_id])
}

model Leave {
  leave_id         String @id @default(uuid())
  student_id       String
  from_date        DateTime
  to_date          DateTime
  reason           String
  document_url     String?
  status           ApprovalStatus @default(pending)
  approved_by      String?
  approved_at      DateTime?
  rejection_reason String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  student Student @relation(fields: [student_id], references: [student_id])
  approvedByUser User? @relation("ApprovedBy", fields: [approved_by], references: [user_id])
}

model Notification {
  notification_id String @id @default(uuid())
  user_id         String
  student_id      String?
  message         String
  type            NotificationType
  channel         NotificationChannel @default(in_app)
  status          NotificationStatus @default(pending)
  sent_at         DateTime?
  read_at         DateTime?
  error_message   String?
  created_at      DateTime @default(now())

  user    User     @relation("UserNotifications", fields: [user_id], references: [user_id])
  student Student? @relation(fields: [student_id], references: [student_id])

  @@index([user_id, read_at])
}

model AuditLog {
  log_id     String @id @default(uuid())
  table_name String
  record_id  String
  action     AuditAction
  changed_by String
  changed_at DateTime @default(now())
  old_value  Json?
  new_value  Json?
  ip_address String?
  user_agent String?
  request_id String?

  changedByUser User @relation("ChangedBy", fields: [changed_by], references: [user_id])

  @@index([table_name, record_id])
}

model Settings {
  key        String   @id
  value      String
  updated_by String
  updated_at DateTime @updatedAt

  updatedByUser User @relation("UpdatedBy", fields: [updated_by], references: [user_id])
}

model BleSession {
  session_id     String   @id @default(uuid())
  timetable_id   String?
  class_session_id String? @unique
  subject_id     String
  section_id     String
  teacher_id     String
  date           DateTime
  start_time     String
  end_time       String
  beacon_nonce   String
  status         String   @default("active") // active | finalized | cancelled
  required_minutes Int    @default(30)       // 55% dwell rule, computed at start
  finalized_at   DateTime?
  anchor_required Boolean  @default(false)   // ESP32 anchor cross-check (flag)
  created_at     DateTime @default(now())

  blePings BlePing[]
  @@index([section_id, date])
}

model BlePing {
  ping_id    String   @id @default(uuid())
  session_id String
  student_id String
  rssi       Int
  seen_at    DateTime @default(now())
  anchor_ok  Boolean?

  bleSession BleSession @relation(fields: [session_id], references: [session_id])
  student    Student    @relation(fields: [student_id], references: [student_id])
  @@unique([session_id, student_id, seen_at])
  @@index([session_id, student_id])
}

model AnchorSighting {
  id         String   @id @default(uuid())
  anchor_id  String
  room_no    String
  student_id String
  rssi       Int
  seen_at    DateTime @default(now())
  student    Student  @relation(fields: [student_id], references: [student_id])
  @@index([student_id, seen_at])
}

// --- Integrity architecture models ---

// Explicit root-of-trust record. One active enrollment per student; supervised/institution-anchored.
// Stores only minimum metadata — never raw enrollment photos unless the chosen implementation requires it.
model BiometricEnrollment {
  enrollment_id     String   @id @default(uuid())
  student_id        String   @unique
  enrollment_method EnrollmentMethod
  enrolled_by       String   // User (staff) who verified institutional identity
  device_id         String?
  face_ciphertext   String?
  face_model        String?
  face_captured_at  DateTime?
  consent_recorded_at DateTime?
  biometric_version Int      @default(1)
  status            BiometricEnrollmentStatus @default(active)
  enrolled_at       DateTime @default(now())
  revoked_at        DateTime?
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  student       Student @relation(fields: [student_id], references: [student_id])
  enrolledByUser User   @relation("BiometricEnrolledBy", fields: [enrolled_by], references: [user_id])

  @@index([status])
}

// Device attestation / integrity telemetry. Signals only — never an automatic guilt verdict.
model DeviceIntegrityEvent {
  event_id        String   @id @default(uuid())
  student_id      String
  device_id       String
  platform        String   // e.g. android / ios
  attestation_type AttestationType
  result          AttestationResult
  reason_code     String?
  session_id      String?
  created_at      DateTime @default(now())

  student Student @relation(fields: [student_id], references: [student_id])

  @@index([student_id, created_at])
  @@index([device_id, created_at])
}

// Credentials are random per reader; only their SHA-256 digest is stored.
model RfidReader {
  reader_id String @id @default(uuid())
  name String
  room_no String @unique
  key_hash String
  is_active Boolean @default(true)
  created_by String
  created_at DateTime @default(now())
  last_seen_at DateTime?
  capture_id String? @unique
  capture_until DateTime?
  capture_hash String?
  capture_suffix String?
  captured_at DateTime?
  owner User @relation(fields: [created_by], references: [user_id])
  events RfidEvent[]
  visits RfidVisit[]
}

// UID is a clonable bearer identifier, not biometric identity. Never store its raw value.
model RfidCard {
  card_id String @id @default(uuid())
  uid_hash String @unique
  uid_suffix String
  student_id String
  is_active Boolean @default(true)
  assigned_by String
  assigned_at DateTime @default(now())
  revoked_at DateTime?
  student Student @relation(fields: [student_id], references: [student_id])
  assignedBy User @relation(fields: [assigned_by], references: [user_id])
  @@index([student_id, is_active])
}

// Idempotent physical-tap result. Replaying an event never toggles entry/exit again.
model RfidEvent {
  event_id String @id
  reader_id String
  uid_hash String
  uid_suffix String
  student_id String?
  session_id String?
  direction String?
  outcome String
  received_at DateTime @default(now())
  reader RfidReader @relation(fields: [reader_id], references: [reader_id])
  student Student? @relation(fields: [student_id], references: [student_id])
  session ClassSession? @relation(fields: [session_id], references: [session_id])
  @@index([student_id, received_at])
  @@index([reader_id, received_at])
}

model RfidVisit {
  visit_id String @id @default(uuid())
  reader_id String
  student_id String
  session_id String
  entry_event_id String @unique
  exit_event_id String? @unique
  entry_at DateTime
  exit_at DateTime?
  reader RfidReader @relation(fields: [reader_id], references: [reader_id])
  student Student @relation(fields: [student_id], references: [student_id])
  session ClassSession @relation(fields: [session_id], references: [session_id])
  @@index([session_id, student_id])
  @@index([student_id, exit_at])
}

// Raw camera frames are NEVER persisted. Pending challenges contain only server-selected actions.
model FaceChallenge {
  challenge_id String @id @default(uuid())
  student_id String
  actor_id String
  actor_session_id String
  class_session_id String?
  purpose String
  phase String?
  enrollment_version Int
  actions Json
  policy Json
  enrollment_method EnrollmentMethod?
  state String @default("pending")
  evidence_hash String? @unique
  failure_reason String?
  created_at DateTime @default(now())
  expires_at DateTime
  completed_at DateTime?
  student Student @relation(fields: [student_id], references: [student_id])
  actor User @relation(fields: [actor_id], references: [user_id])
  session ClassSession? @relation(fields: [class_session_id], references: [session_id])
  @@index([student_id, created_at])
  @@index([class_session_id, state])
}

// Snapshot at first RFID entry: enabling policy never changes an already-started requirement.
model FaceRequirement {
  requirement_id String @id @default(uuid())
  student_id String
  session_id String
  required Boolean @default(false)
  spot_due_at DateTime
  deadline_at DateTime
  join_passed_at DateTime?
  spot_passed_at DateTime?
  created_at DateTime @default(now())
  student Student @relation(fields: [student_id], references: [student_id])
  session ClassSession @relation(fields: [session_id], references: [session_id])
  @@unique([student_id, session_id])
  @@index([session_id])
}
