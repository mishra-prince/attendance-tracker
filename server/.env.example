DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/attendance"
# Generate three distinct random values, each at least 32 characters.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
BLE_BEACON_SECRET=""
NODE_ENV=development
PORT=4100
# Exact browser origins, comma-separated. https://localhost is allowed for the APK.
CLIENT_URL=http://localhost:5173
ATTENDANCE_TIMEZONE=Asia/Kolkata
# Only set to 1 when the API is reachable solely through one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Demo seed wipes its target DB and is blocked unless explicitly enabled.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
