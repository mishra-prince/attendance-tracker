DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/attendance"
# Generate four distinct random values, each at least 32 characters.
JWT_SECRET=""
JWT_REFRESH_SECRET=""
BLE_BEACON_SECRET=""
# Keep stable: rotating this makes existing card hashes unreadable. Back it up privately.
RFID_CARD_HASH_SECRET=""
NODE_ENV=development
PORT=4100
# Exact browser origins, comma-separated. https://localhost is allowed for the APK.
CLIENT_URL=http://localhost:5173
ATTENDANCE_TIMEZONE=Asia/Kolkata
# Only set to 1 when the API is reachable solely through one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Demo seed wipes its target DB and is blocked unless explicitly enabled.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=

# Permanent face verification (Docker supplies the worker/runtime/models).
# Keep disabled until the trusted worker is installed; mandatory face policy defaults on; use the Docker runtime before operational use.
FACE_VISION_ENABLED=false
# FACE_PYTHON=/absolute/path/to/python
# FACE_MODEL_DIR=/absolute/path/to/checksum-verified/models
# Optional stable dedicated root, set BEFORE enrollment; otherwise derives from RFID_CARD_HASH_SECRET.
# FACE_TEMPLATE_ENCRYPTION_KEY=your-private-stable-random-value-at-least-32-characters
