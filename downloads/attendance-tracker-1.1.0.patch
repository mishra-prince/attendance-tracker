+    "id" TEXT NOT NULL,
+    "anchor_id" TEXT NOT NULL,
+    "room_no" TEXT NOT NULL,
+    "student_id" TEXT NOT NULL,
+    "rssi" INTEGER NOT NULL,
+    "seen_at" TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+    CONSTRAINT "AnchorSighting_pkey" PRIMARY KEY ("id")
+);
